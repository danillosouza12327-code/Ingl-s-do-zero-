[{"id": "0", "name": "Nível 0 — Absoluto zero", "mods": [{"id": "0.1", "title": "Cumprimentos e apresentações", "lessons": [{"id": "0.1.1", "title": "Olá! Cumprimentos", "script": [{"l": "pt", "t": "Bem-vindo à sua primeira aula! Hoje você vai aprender a cumprimentar as pessoas em inglês."}, {"l": "en", "t": "Hello", "tr": "Olá"}, {"l": "pt", "t": "Isso significa: Olá. Repita comigo."}, {"l": "en", "t": "Hello", "tr": "Olá"}, {"l": "en", "t": "Hi", "tr": "Oi"}, {"l": "pt", "t": "Isso significa: Oi. Repita comigo."}, {"l": "en", "t": "Hi", "tr": "Oi"}, {"l": "en", "t": "Good morning", "tr": "Bom dia"}, {"l": "pt", "t": "Isso significa: Bom dia. Repita comigo."}, {"l": "en", "t": "Good morning", "tr": "Bom dia"}, {"l": "en", "t": "Good night", "tr": "Boa noite"}, {"l": "pt", "t": "Isso significa: Boa noite. Repita comigo."}, {"l": "en", "t": "Good night", "tr": "Boa noite"}, {"l": "en", "t": "Goodbye", "tr": "Tchau"}, {"l": "pt", "t": "Isso significa: Tchau. Repita comigo."}, {"l": "en", "t": "Goodbye", "tr": "Tchau"}, {"l": "pt", "t": "Muito bem! Agora vamos praticar o que você aprendeu."}], "vocab": [["Hello", "Olá", "Rélou"], ["Hi", "Oi", "Rai"], ["Good morning", "Bom dia", "Gud mórning"], ["Good night", "Boa noite", "Gud náit"], ["Goodbye", "Tchau", "Gudbái"]], "listen": {"t": "Good morning", "ops": ["Bom dia", "Boa noite", "Tchau"], "a": 0}, "write": {"q": "Escreva em inglês: Olá", "a": ["hello"]}, "quiz": [{"q": "Como se diz \"Tchau\"?", "ops": ["Hello", "Goodbye", "Hi"], "a": 1}, {"q": "\"Good night\" significa:", "ops": ["Bom dia", "Boa noite", "Oi"], "a": 1}]}, {"id": "0.1.2", "title": "Meu nome é...", "script": [{"l": "pt", "t": "Agora você vai aprender a se apresentar e perguntar como a pessoa está."}, {"l": "en", "t": "My name is Ana.", "tr": "Meu nome é Ana."}, {"l": "pt", "t": "Isso significa: Meu nome é Ana.. Repita comigo."}, {"l": "en", "t": "My name is Ana.", "tr": "Meu nome é Ana."}, {"l": "en", "t": "What is your name?", "tr": "Qual é o seu nome?"}, {"l": "pt", "t": "Isso significa: Qual é o seu nome?. Repita comigo."}, {"l": "en", "t": "What is your name?", "tr": "Qual é o seu nome?"}, {"l": "en", "t": "Nice to meet you.", "tr": "Prazer em conhecer você."}, {"l": "pt", "t": "Isso significa: Prazer em conhecer você.. Repita comigo."}, {"l": "en", "t": "Nice to meet you.", "tr": "Prazer em conhecer você."}, {"l": "en", "t": "I am fine.", "tr": "Eu estou bem."}, {"l": "pt", "t": "Isso significa: Eu estou bem.. Repita comigo."}, {"l": "en", "t": "I am fine.", "tr": "Eu estou bem."}, {"l": "en", "t": "How are you?", "tr": "Como você está?"}, {"l": "pt", "t": "Isso significa: Como você está?. Repita comigo."}, {"l": "en", "t": "How are you?", "tr": "Como você está?"}, {"l": "pt", "t": "Muito bem! Agora vamos praticar o que você aprendeu."}], "vocab": [["My name is Ana.", "Meu nome é Ana.", "Mai neim iz Ana"], ["What is your name?", "Qual é o seu nome?", "Uót iz iór neim?"], ["Nice to meet you.", "Prazer em conhecer você.", "Náis tu mít iú"], ["I am fine.", "Eu estou bem.", "Ai am fáin"], ["How are you?", "Como você está?", "Rau ar iú?"]], "listen": {"t": "What is your name?", "ops": ["Qual é o seu nome?", "Como você está?", "Onde você mora?"], "a": 0}, "write": {"q": "Escreva em inglês: Eu estou bem", "a": ["i am fine"]}, "quiz": [{"q": "\"How are you?\" significa:", "ops": ["Como você está?", "Qual seu nome?", "Tchau"], "a": 0}, {"q": "Como se diz \"Prazer em conhecer você\"?", "ops": ["I am fine.", "Nice to meet you.", "Good night."], "a": 1}]}]}, {"id": "0.2", "title": "Números e cores", "lessons": [{"id": "0.2.1", "title": "Números de 1 a 6", "script": [{"l": "pt", "t": "Números são muito úteis no dia a dia. Vamos aprender de um a seis."}, {"l": "en", "t": "One", "tr": "Um"}, {"l": "pt", "t": "Isso significa: Um. Repita comigo."}, {"l": "en", "t": "One", "tr": "Um"}, {"l": "en", "t": "Two", "tr": "Dois"}, {"l": "pt", "t": "Isso significa: Dois. Repita comigo."}, {"l": "en", "t": "Two", "tr": "Dois"}, {"l": "en", "t": "Three", "tr": "Três"}, {"l": "pt", "t": "Isso significa: Três. Repita comigo."}, {"l": "en", "t": "Three", "tr": "Três"}, {"l": "en", "t": "Four", "tr": "Quatro"}, {"l": "pt", "t": "Isso significa: Quatro. Repita comigo."}, {"l": "en", "t": "Four", "tr": "Quatro"}, {"l": "en", "t": "Five", "tr": "Cinco"}, {"l": "pt", "t": "Isso significa: Cinco. Repita comigo."}, {"l": "en", "t": "Five", "tr": "Cinco"}, {"l": "en", "t": "Six", "tr": "Seis"}, {"l": "pt", "t": "Isso significa: Seis. Repita comigo."}, {"l": "en", "t": "Six", "tr": "Seis"}, {"l": "pt", "t": "Muito bem! Agora vamos praticar o que você aprendeu."}], "vocab": [["One", "Um", "Uãn"], ["Two", "Dois", "Tú"], ["Three", "Três", "Thrí"], ["Four", "Quatro", "Fór"], ["Five", "Cinco", "Fáiv"], ["Six", "Seis", "Síks"]], "listen": {"t": "Three", "ops": ["Dois", "Três", "Quatro"], "a": 1}, "write": {"q": "Escreva em inglês: Cinco", "a": ["five"]}, "quiz": [{"q": "Como se diz \"Dois\"?", "ops": ["Two", "Four", "One"], "a": 0}, {"q": "\"Six\" significa:", "ops": ["Cinco", "Seis", "Três"], "a": 1}]}, {"id": "0.2.2", "title": "Cores", "script": [{"l": "pt", "t": "Vamos aprender as cores principais em inglês."}, {"l": "en", "t": "Red", "tr": "Vermelho"}, {"l": "pt", "t": "Isso significa: Vermelho. Repita comigo."}, {"l": "en", "t": "Red", "tr": "Vermelho"}, {"l": "en", "t": "Blue", "tr": "Azul"}, {"l": "pt", "t": "Isso significa: Azul. Repita comigo."}, {"l": "en", "t": "Blue", "tr": "Azul"}, {"l": "en", "t": "Green", "tr": "Verde"}, {"l": "pt", "t": "Isso significa: Verde. Repita comigo."}, {"l": "en", "t": "Green", "tr": "Verde"}, {"l": "en", "t": "Yellow", "tr": "Amarelo"}, {"l": "pt", "t": "Isso significa: Amarelo. Repita comigo."}, {"l": "en", "t": "Yellow", "tr": "Amarelo"}, {"l": "en", "t": "Black", "tr": "Preto"}, {"l": "pt", "t": "Isso significa: Preto. Repita comigo."}, {"l": "en", "t": "Black", "tr": "Preto"}, {"l": "en", "t": "White", "tr": "Branco"}, {"l": "pt", "t": "Isso significa: Branco. Repita comigo."}, {"l": "en", "t": "White", "tr": "Branco"}, {"l": "pt", "t": "Muito bem! Agora vamos praticar o que você aprendeu."}], "vocab": [["Red", "Vermelho", "Réd"], ["Blue", "Azul", "Blú"], ["Green", "Verde", "Grín"], ["Yellow", "Amarelo", "Iélou"], ["Black", "Preto", "Blék"], ["White", "Branco", "Uáit"]], "listen": {"t": "Blue", "ops": ["Verde", "Azul", "Vermelho"], "a": 1}, "write": {"q": "Escreva em inglês: Verde", "a": ["green"]}, "quiz": [{"q": "Como se diz \"Preto\"?", "ops": ["White", "Black", "Red"], "a": 1}, {"q": "\"Yellow\" significa:", "ops": ["Amarelo", "Azul", "Branco"], "a": 0}]}]}, {"id": "0.3", "title": "Família e comidas", "lessons": [{"id": "0.3.1", "title": "Família", "script": [{"l": "pt", "t": "Hoje vamos falar sobre as pessoas da família e os amigos."}, {"l": "en", "t": "Mother", "tr": "Mãe"}, {"l": "pt", "t": "Isso significa: Mãe. Repita comigo."}, {"l": "en", "t": "Mother", "tr": "Mãe"}, {"l": "en", "t": "Father", "tr": "Pai"}, {"l": "pt", "t": "Isso significa: Pai. Repita comigo."}, {"l": "en", "t": "Father", "tr": "Pai"}, {"l": "en", "t": "Brother", "tr": "Irmão"}, {"l": "pt", "t": "Isso significa: Irmão. Repita comigo."}, {"l": "en", "t": "Brother", "tr": "Irmão"}, {"l": "en", "t": "Sister", "tr": "Irmã"}, {"l": "pt", "t": "Isso significa: Irmã. Repita comigo."}, {"l": "en", "t": "Sister", "tr": "Irmã"}, {"l": "en", "t": "Family", "tr": "Família"}, {"l": "pt", "t": "Isso significa: Família. Repita comigo."}, {"l": "en", "t": "Family", "tr": "Família"}, {"l": "en", "t": "Friend", "tr": "Amigo"}, {"l": "pt", "t": "Isso significa: Amigo. Repita comigo."}, {"l": "en", "t": "Friend", "tr": "Amigo"}, {"l": "pt", "t": "Muito bem! Agora vamos praticar o que você aprendeu."}], "vocab": [["Mother", "Mãe", "Mâder"], ["Father", "Pai", "Fáder"], ["Brother", "Irmão", "Bráder"], ["Sister", "Irmã", "Síster"], ["Family", "Família", "Fémili"], ["Friend", "Amigo", "Frénd"]], "listen": {"t": "Mother", "ops": ["Pai", "Mãe", "Irmã"], "a": 1}, "write": {"q": "Escreva em inglês: Amigo", "a": ["friend"]}, "quiz": [{"q": "Como se diz \"Pai\"?", "ops": ["Father", "Brother", "Mother"], "a": 0}, {"q": "\"Sister\" significa:", "ops": ["Irmão", "Irmã", "Mãe"], "a": 1}]}, {"id": "0.3.2", "title": "Comidas e bebidas", "script": [{"l": "pt", "t": "Vamos aprender palavras de comida e bebida, muito úteis em restaurantes."}, {"l": "en", "t": "Water", "tr": "Água"}, {"l": "pt", "t": "Isso significa: Água. Repita comigo."}, {"l": "en", "t": "Water", "tr": "Água"}, {"l": "en", "t": "Coffee", "tr": "Café"}, {"l": "pt", "t": "Isso significa: Café. Repita comigo."}, {"l": "en", "t": "Coffee", "tr": "Café"}, {"l": "en", "t": "Bread", "tr": "Pão"}, {"l": "pt", "t": "Isso significa: Pão. Repita comigo."}, {"l": "en", "t": "Bread", "tr": "Pão"}, {"l": "en", "t": "Rice", "tr": "Arroz"}, {"l": "pt", "t": "Isso significa: Arroz. Repita comigo."}, {"l": "en", "t": "Rice", "tr": "Arroz"}, {"l": "en", "t": "Milk", "tr": "Leite"}, {"l": "pt", "t": "Isso significa: Leite. Repita comigo."}, {"l": "en", "t": "Milk", "tr": "Leite"}, {"l": "en", "t": "Apple", "tr": "Maçã"}, {"l": "pt", "t": "Isso significa: Maçã. Repita comigo."}, {"l": "en", "t": "Apple", "tr": "Maçã"}, {"l": "pt", "t": "Muito bem! Agora vamos praticar o que você aprendeu."}], "vocab": [["Water", "Água", "Uórer"], ["Coffee", "Café", "Cófi"], ["Bread", "Pão", "Bréd"], ["Rice", "Arroz", "Ráis"], ["Milk", "Leite", "Mílk"], ["Apple", "Maçã", "Épol"]], "listen": {"t": "Water", "ops": ["Água", "Leite", "Café"], "a": 0}, "write": {"q": "Escreva em inglês: Leite", "a": ["milk"]}, "quiz": [{"q": "Como se diz \"Arroz\"?", "ops": ["Bread", "Rice", "Apple"], "a": 1}, {"q": "\"Coffee\" significa:", "ops": ["Café", "Água", "Pão"], "a": 0}]}]}]}, {"id": "a1", "name": "Nível A1 — Iniciante", "mods": [{"id": "a1.1", "title": "Verb to be, pronomes e artigos", "lessons": [{"id": "a1.1.1", "title": "Verb to be: I am, you are", "script": [{"l": "pt", "t": "Vamos começar o nível A1 com o verbo mais importante do inglês: to be."}, {"l": "pt", "t": "To be significa ser ou estar. Com I usamos am. Com you, we e they usamos are. Com he, she e it usamos is."}, {"l": "en", "t": "I am a student.", "tr": "Eu sou estudante."}, {"l": "pt", "t": "Isso significa: Eu sou estudante. Repita comigo."}, {"l": "en", "t": "I am a student.", "tr": "Eu sou estudante."}, {"l": "en", "t": "You are my friend.", "tr": "Você é meu amigo."}, {"l": "pt", "t": "Isso significa: Você é meu amigo. Repita comigo."}, {"l": "en", "t": "You are my friend.", "tr": "Você é meu amigo."}, {"l": "en", "t": "He is a doctor.", "tr": "Ele é médico."}, {"l": "pt", "t": "Isso significa: Ele é médico. Repita comigo."}, {"l": "en", "t": "He is a doctor.", "tr": "Ele é médico."}, {"l": "en", "t": "She is happy.", "tr": "Ela está feliz."}, {"l": "pt", "t": "Isso significa: Ela está feliz. Repita comigo."}, {"l": "en", "t": "She is happy.", "tr": "Ela está feliz."}, {"l": "en", "t": "We are ready.", "tr": "Nós estamos prontos."}, {"l": "pt", "t": "Isso significa: Nós estamos prontos. Repita comigo."}, {"l": "en", "t": "We are ready.", "tr": "Nós estamos prontos."}, {"l": "en", "t": "They are at home.", "tr": "Eles estão em casa."}, {"l": "pt", "t": "Isso significa: Eles estão em casa. Repita comigo."}, {"l": "en", "t": "They are at home.", "tr": "Eles estão em casa."}, {"l": "pt", "t": "Muito bem! Agora vamos praticar o que você aprendeu."}], "vocab": [["I am a student.", "Eu sou estudante.", "Ai am a stiúdent"], ["You are my friend.", "Você é meu amigo.", "Iú ar mai frénd"], ["He is a doctor.", "Ele é médico.", "Rí iz a dóctor"], ["She is happy.", "Ela está feliz.", "Chí iz répi"], ["We are ready.", "Nós estamos prontos.", "Uí ar rédi"], ["They are at home.", "Eles estão em casa.", "Dêi ar ét rôum"]], "listen": {"t": "She is happy.", "ops": ["Ele é médico.", "Ela está feliz.", "Nós estamos prontos."], "a": 1}, "write": {"q": "Escreva em inglês: Eu sou estudante.", "a": ["i am a student"]}, "quiz": [{"q": "Complete: You ___ my friend.", "ops": ["am", "are", "is"], "a": 1}, {"q": "Complete: He ___ a doctor.", "ops": ["is", "are", "am"], "a": 0}]}, {"id": "a1.1.2", "title": "Artigos: a, an, the", "script": [{"l": "pt", "t": "Agora vamos aprender os artigos, que aparecem antes dos nomes."}, {"l": "pt", "t": "Use a antes de som de consoante, como a book. Use an antes de som de vogal, como an apple. The significa o, a, os ou as."}, {"l": "en", "t": "a book", "tr": "um livro"}, {"l": "pt", "t": "Isso significa: um livro Repita comigo."}, {"l": "en", "t": "a book", "tr": "um livro"}, {"l": "en", "t": "an apple", "tr": "uma maçã"}, {"l": "pt", "t": "Isso significa: uma maçã Repita comigo."}, {"l": "en", "t": "an apple", "tr": "uma maçã"}, {"l": "en", "t": "an orange", "tr": "uma laranja"}, {"l": "pt", "t": "Isso significa: uma laranja Repita comigo."}, {"l": "en", "t": "an orange", "tr": "uma laranja"}, {"l": "en", "t": "the house", "tr": "a casa"}, {"l": "pt", "t": "Isso significa: a casa Repita comigo."}, {"l": "en", "t": "the house", "tr": "a casa"}, {"l": "en", "t": "a dog", "tr": "um cachorro"}, {"l": "pt", "t": "Isso significa: um cachorro Repita comigo."}, {"l": "en", "t": "a dog", "tr": "um cachorro"}, {"l": "en", "t": "the water", "tr": "a água"}, {"l": "pt", "t": "Isso significa: a água Repita comigo."}, {"l": "en", "t": "the water", "tr": "a água"}, {"l": "pt", "t": "Muito bem! Agora vamos praticar o que você aprendeu."}], "vocab": [["a book", "um livro", "a búk"], ["an apple", "uma maçã", "ân épol"], ["an orange", "uma laranja", "ân órindj"], ["the house", "a casa", "dâ ráus"], ["a dog", "um cachorro", "a dóg"], ["the water", "a água", "dâ uórer"]], "listen": {"t": "an apple", "ops": ["um livro", "uma maçã", "um cachorro"], "a": 1}, "write": {"q": "Escreva em inglês: um livro", "a": ["a book"]}, "quiz": [{"q": "Complete: ___ orange", "ops": ["a", "an", "are"], "a": 1}, {"q": "Complete: ___ dog", "ops": ["an", "a", "is"], "a": 1}]}]}, {"id": "a1.2", "title": "Plural, possessivos e Simple Present", "lessons": [{"id": "a1.2.1", "title": "Plural e possessivos", "script": [{"l": "pt", "t": "Hoje você vai aprender a falar de mais de uma coisa e de quem é cada coisa."}, {"l": "pt", "t": "Para o plural, geralmente acrescentamos s: book vira books. Possessivos mostram de quem é algo: my é meu, your é seu, his é dele e her é dela."}, {"l": "en", "t": "two books", "tr": "dois livros"}, {"l": "pt", "t": "Isso significa: dois livros Repita comigo."}, {"l": "en", "t": "two books", "tr": "dois livros"}, {"l": "en", "t": "three dogs", "tr": "três cachorros"}, {"l": "pt", "t": "Isso significa: três cachorros Repita comigo."}, {"l": "en", "t": "three dogs", "tr": "três cachorros"}, {"l": "en", "t": "my car", "tr": "meu carro"}, {"l": "pt", "t": "Isso significa: meu carro Repita comigo."}, {"l": "en", "t": "my car", "tr": "meu carro"}, {"l": "en", "t": "your phone", "tr": "seu celular"}, {"l": "pt", "t": "Isso significa: seu celular Repita comigo."}, {"l": "en", "t": "your phone", "tr": "seu celular"}, {"l": "en", "t": "his mother", "tr": "a mãe dele"}, {"l": "pt", "t": "Isso significa: a mãe dele Repita comigo."}, {"l": "en", "t": "his mother", "tr": "a mãe dele"}, {"l": "en", "t": "her father", "tr": "o pai dela"}, {"l": "pt", "t": "Isso significa: o pai dela Repita comigo."}, {"l": "en", "t": "her father", "tr": "o pai dela"}, {"l": "pt", "t": "Muito bem! Agora vamos praticar o que você aprendeu."}], "vocab": [["two books", "dois livros", "tú búks"], ["three dogs", "três cachorros", "thrí dógs"], ["my car", "meu carro", "mai kár"], ["your phone", "seu celular", "iór fôun"], ["his mother", "a mãe dele", "riz mâder"], ["her father", "o pai dela", "rér fáder"]], "listen": {"t": "my car", "ops": ["seu celular", "meu carro", "a mãe dele"], "a": 1}, "write": {"q": "Escreva em inglês: meu carro", "a": ["my car"]}, "quiz": [{"q": "Plural de \"dog\":", "ops": ["dogs", "doges", "dog"], "a": 0}, {"q": "\"her father\" significa:", "ops": ["o pai dela", "o pai dele", "meu pai"], "a": 0}]}, {"id": "a1.2.2", "title": "Simple Present", "script": [{"l": "pt", "t": "O Simple Present serve para falar de rotinas e fatos."}, {"l": "pt", "t": "Com he, she e it acrescentamos s ao verbo: I work, mas she works. Com I, you, we e they o verbo não muda."}, {"l": "en", "t": "I work every day.", "tr": "Eu trabalho todos os dias."}, {"l": "pt", "t": "Isso significa: Eu trabalho todos os dias. Repita comigo."}, {"l": "en", "t": "I work every day.", "tr": "Eu trabalho todos os dias."}, {"l": "en", "t": "She works at home.", "tr": "Ela trabalha em casa."}, {"l": "pt", "t": "Isso significa: Ela trabalha em casa. Repita comigo."}, {"l": "en", "t": "She works at home.", "tr": "Ela trabalha em casa."}, {"l": "en", "t": "We eat rice.", "tr": "Nós comemos arroz."}, {"l": "pt", "t": "Isso significa: Nós comemos arroz. Repita comigo."}, {"l": "en", "t": "We eat rice.", "tr": "Nós comemos arroz."}, {"l": "en", "t": "He drinks coffee.", "tr": "Ele bebe café."}, {"l": "pt", "t": "Isso significa: Ele bebe café. Repita comigo."}, {"l": "en", "t": "He drinks coffee.", "tr": "Ele bebe café."}, {"l": "en", "t": "They study English.", "tr": "Eles estudam inglês."}, {"l": "pt", "t": "Isso significa: Eles estudam inglês. Repita comigo."}, {"l": "en", "t": "They study English.", "tr": "Eles estudam inglês."}, {"l": "en", "t": "I like music.", "tr": "Eu gosto de música."}, {"l": "pt", "t": "Isso significa: Eu gosto de música. Repita comigo."}, {"l": "en", "t": "I like music.", "tr": "Eu gosto de música."}, {"l": "pt", "t": "Muito bem! Agora vamos praticar o que você aprendeu."}], "vocab": [["I work every day.", "Eu trabalho todos os dias.", "Ai uôrk évri dêi"], ["She works at home.", "Ela trabalha em casa.", "Chí uôrks ét rôum"], ["We eat rice.", "Nós comemos arroz.", "Uí ít ráis"], ["He drinks coffee.", "Ele bebe café.", "Rí drínks cófi"], ["They study English.", "Eles estudam inglês.", "Dêi stâdi ínglish"], ["I like music.", "Eu gosto de música.", "Ai láik miúzik"]], "listen": {"t": "He drinks coffee.", "ops": ["Ele bebe café.", "Nós comemos arroz.", "Eu gosto de música."], "a": 0}, "write": {"q": "Escreva em inglês: Nós comemos arroz.", "a": ["we eat rice"]}, "quiz": [{"q": "Complete: She ___ at home.", "ops": ["work", "works", "working"], "a": 1}, {"q": "Complete: They ___ English.", "ops": ["studies", "study", "studying"], "a": 1}]}]}, {"id": "a1.3", "title": "Perguntas, negação e frases do dia a dia", "lessons": [{"id": "a1.3.1", "title": "Perguntas básicas", "script": [{"l": "pt", "t": "Vamos aprender a fazer perguntas simples em inglês."}, {"l": "pt", "t": "Com to be, invertemos a ordem: You are happy vira Are you happy? Também usamos what para o que, where para onde e who para quem. Com outros verbos, usamos do: Do you like coffee?"}, {"l": "en", "t": "Are you happy?", "tr": "Você está feliz?"}, {"l": "pt", "t": "Isso significa: Você está feliz? Repita comigo."}, {"l": "en", "t": "Are you happy?", "tr": "Você está feliz?"}, {"l": "en", "t": "Where are you?", "tr": "Onde você está?"}, {"l": "pt", "t": "Isso significa: Onde você está? Repita comigo."}, {"l": "en", "t": "Where are you?", "tr": "Onde você está?"}, {"l": "en", "t": "What is this?", "tr": "O que é isto?"}, {"l": "pt", "t": "Isso significa: O que é isto? Repita comigo."}, {"l": "en", "t": "What is this?", "tr": "O que é isto?"}, {"l": "en", "t": "Who is she?", "tr": "Quem é ela?"}, {"l": "pt", "t": "Isso significa: Quem é ela? Repita comigo."}, {"l": "en", "t": "Who is she?", "tr": "Quem é ela?"}, {"l": "en", "t": "Where is the bank?", "tr": "Onde fica o banco?"}, {"l": "pt", "t": "Isso significa: Onde fica o banco? Repita comigo."}, {"l": "en", "t": "Where is the bank?", "tr": "Onde fica o banco?"}, {"l": "en", "t": "Do you like coffee?", "tr": "Você gosta de café?"}, {"l": "pt", "t": "Isso significa: Você gosta de café? Repita comigo."}, {"l": "en", "t": "Do you like coffee?", "tr": "Você gosta de café?"}, {"l": "pt", "t": "Muito bem! Agora vamos praticar o que você aprendeu."}], "vocab": [["Are you happy?", "Você está feliz?", "Ar iú répi?"], ["Where are you?", "Onde você está?", "Uér ar iú?"], ["What is this?", "O que é isto?", "Uót iz dis?"], ["Who is she?", "Quem é ela?", "Rú iz chí?"], ["Where is the bank?", "Onde fica o banco?", "Uér iz dâ bénk?"], ["Do you like coffee?", "Você gosta de café?", "Du iú láik cófi?"]], "listen": {"t": "Where are you?", "ops": ["Quem é ela?", "Onde você está?", "O que é isto?"], "a": 1}, "write": {"q": "Escreva em inglês: Quem é ela?", "a": ["who is she"]}, "quiz": [{"q": "\"What\" significa:", "ops": ["O que", "Onde", "Quem"], "a": 0}, {"q": "\"Where\" significa:", "ops": ["Quem", "Onde", "Quando"], "a": 1}]}, {"id": "a1.3.2", "title": "Negação e frases do dia a dia", "script": [{"l": "pt", "t": "Para fechar o A1, vamos aprender a dizer não e algumas frases muito usadas."}, {"l": "pt", "t": "Com to be, negamos com not: I am not tired. Com outros verbos, usamos do not ou does not: I do not know. Com he, she e it, usamos does not."}, {"l": "en", "t": "I am not tired.", "tr": "Eu não estou cansado."}, {"l": "pt", "t": "Isso significa: Eu não estou cansado. Repita comigo."}, {"l": "en", "t": "I am not tired.", "tr": "Eu não estou cansado."}, {"l": "en", "t": "She is not here.", "tr": "Ela não está aqui."}, {"l": "pt", "t": "Isso significa: Ela não está aqui. Repita comigo."}, {"l": "en", "t": "She is not here.", "tr": "Ela não está aqui."}, {"l": "en", "t": "I do not know.", "tr": "Eu não sei."}, {"l": "pt", "t": "Isso significa: Eu não sei. Repita comigo."}, {"l": "en", "t": "I do not know.", "tr": "Eu não sei."}, {"l": "en", "t": "He does not work here.", "tr": "Ele não trabalha aqui."}, {"l": "pt", "t": "Isso significa: Ele não trabalha aqui. Repita comigo."}, {"l": "en", "t": "He does not work here.", "tr": "Ele não trabalha aqui."}, {"l": "en", "t": "See you tomorrow.", "tr": "Até amanhã."}, {"l": "pt", "t": "Isso significa: Até amanhã. Repita comigo."}, {"l": "en", "t": "See you tomorrow.", "tr": "Até amanhã."}, {"l": "en", "t": "Have a nice day!", "tr": "Tenha um bom dia!"}, {"l": "pt", "t": "Isso significa: Tenha um bom dia! Repita comigo."}, {"l": "en", "t": "Have a nice day!", "tr": "Tenha um bom dia!"}, {"l": "pt", "t": "Muito bem! Agora vamos praticar o que você aprendeu."}], "vocab": [["I am not tired.", "Eu não estou cansado.", "Ai am nót táierd"], ["She is not here.", "Ela não está aqui.", "Chí iz nót rír"], ["I do not know.", "Eu não sei.", "Ai du nót nôu"], ["He does not work here.", "Ele não trabalha aqui.", "Rí dâz nót uôrk rír"], ["See you tomorrow.", "Até amanhã.", "Sí iú tumórou"], ["Have a nice day!", "Tenha um bom dia!", "Rév a náis dêi!"]], "listen": {"t": "I do not know.", "ops": ["Eu não estou cansado.", "Eu não sei.", "Até amanhã."], "a": 1}, "write": {"q": "Escreva em inglês: Até amanhã.", "a": ["see you tomorrow"]}, "quiz": [{"q": "Complete: I ___ not tired.", "ops": ["am", "do", "does"], "a": 0}, {"q": "Complete: He ___ not work here.", "ops": ["do", "does", "is"], "a": 1}]}]}]}, {"id": "a2", "name": "Nível A2 — Básico", "mods": [{"id": "a2.1", "title": "Simple Past e futuro", "lessons": []}, {"id": "a2.2", "title": "Present Continuous, comparativos e superlativos", "lessons": []}, {"id": "a2.3", "title": "Modal verbs e situações reais", "lessons": []}]}, {"id": "b1", "name": "Nível B1 — Intermediário", "mods": [{"id": "b1.1", "title": "Tempos verbais e phrasal verbs", "lessons": []}, {"id": "b1.2", "title": "Expressões, listening, leitura e escrita", "lessons": []}]}, {"id": "b2", "name": "Nível B2 — Intermediário avançado", "mods": [{"id": "b2.1", "title": "Conversação, idioms e inglês profissional", "lessons": []}, {"id": "b2.2", "title": "Listening, pronúncia e escrita", "lessons": []}]}, {"id": "c1", "name": "Nível C1 — Avançado", "mods": [{"id": "c1.1", "title": "Debates, apresentações e vocabulário avançado", "lessons": []}, {"id": "c1.2", "title": "Sotaques, expressões naturais e fluência", "lessons": []}]}, {"id": "c2", "name": "Nível C2 — Proficiência", "mods": [{"id": "c2.1", "title": "Fluência, precisão e compreensão", "lessons": []}]}]